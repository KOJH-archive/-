# 복사해 .env로 저장한 뒤 실제 발급값을 직접 입력하세요. 키 값은 채팅/저장소에 넣지 마세요.
# 법제처 국가법령정보 공동활용: https://open.law.go.kr/
LAW_OC=7jK3hR92nS1tVO
# localhost Ollama 서버. 비우면 AI 분석 없이 원문 조회·검증만 수행합니다.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# 모델 자동 호출을 켜려면 1, 사용자 UI에서 별도 켤 수도 있습니다.
ENABLE_LLM=0
# 기본은 실제 공식 API / 샘플은 UI에서 명시적으로 켭니다.
DEMO_MODE=0
DB_PATH=data/legal_studio.sqlite3
# 조문/판례 본문 로컬 캐시 저장 여부 (공식 데이터 이용조건 준수)
CACHE_SOURCE_DOCUMENTS=1
# 선택: Ollama에 설치된 임베딩 전용 모델명. 채팅 모델명과 별도 설정.
OLLAMA_EMBED_MODEL=
# 예: qwen3-embedding:0.6b (ollama pull로 먼저 설치)
# 기본값은 루프백 주소만 허용. 신뢰하는 원격 서버 사용 시만 명시적으로 1.
ALLOW_REMOTE_OLLAMA=0
